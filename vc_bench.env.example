# 复制到 ~/.config/vc_bench.env 后填值，然后 chmod 600 ~/.config/vc_bench.env
# 不要把填好值的文件发到群里或提交到仓库

# PostHog（项目号找管理员要；填错项目会 403）
export POSTHOG_HOST=https://us.posthog.com
export POSTHOG_PROJECT_ID=
export POSTHOG_PERSONAL_API_KEY=

# Langfuse
export LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# 项目 ID 用来拼 trace 链接，在 Langfuse 网页 URL 的 /project/<这里>/ 里
export LANGFUSE_PROJECT_ID=
export LANGFUSE_PUBLIC_KEY=
export LANGFUSE_SECRET_KEY=

# arena 的 Supabase Postgres（只有 arena-db 子命令需要）
export ARENA_DATABASE_DSN=
